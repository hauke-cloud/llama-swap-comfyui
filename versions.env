# Build-time tunables for the llama-swap-comfyui mirror.
#
# Sourced by scripts/plan-builds.sh and scripts/build-image.sh, which each use a
# different subset -- so every variable looks unused from one of them.
# shellcheck disable=SC2034
#
# Everything here can be overridden per-run via workflow_dispatch inputs or by
# exporting the variable before calling scripts/build-image.sh locally.

# ---------------------------------------------------------------------------
# Upstream / downstream image coordinates
# ---------------------------------------------------------------------------

# The image we derive from. Tag names are mirrored 1:1 onto our own package.
UPSTREAM_IMAGE="ghcr.io/mostlygeek/llama-swap"

# Our published package. Defaults to ghcr.io/<this repo> so forks publish into
# their own namespace with no code changes.
MIRROR_IMAGE="${MIRROR_IMAGE:-ghcr.io/${GITHUB_REPOSITORY:-hauke-cloud/llama-swap-comfyui}}"

# ---------------------------------------------------------------------------
# Mirror scope
# ---------------------------------------------------------------------------

# Upstream backends to derive from. ComfyUI needs a real PyTorch accelerator,
# which upstream only offers on the CUDA backends -- vulkan/musa/cpu would get
# CPU-only torch and intel would need the (separate) XPU wheel index.
BACKENDS="cuda cuda13"

# Upstream ships each backend twice: root (uid 0) and -non-root (uid 10001).
VARIANTS="root non-root"

# How many of the most recent upstream llama.cpp builds to cover. 1 == only
# track the newest; raise it to backfill a few builds after an outage.
BUILD_DEPTH="${BUILD_DEPTH:-1}"

# Hard ceiling on images built per run, so a bad diff can never fan out into
# hundreds of multi-gigabyte builds.
MAX_BUILDS="${MAX_BUILDS:-8}"

# ---------------------------------------------------------------------------
# ComfyUI
# ---------------------------------------------------------------------------

# Git ref of ComfyUI to install. Empty == resolve comfyanonymous/ComfyUI's
# latest GitHub release at build time and stamp it into an OCI label.
COMFYUI_REF="${COMFYUI_REF:-}"

# Where ComfyUI lives in the image, and where its mutable state goes. The data
# directory is what you want to mount a volume on.
COMFYUI_HOME="/opt/comfyui"
COMFYUI_DATA="/data/comfyui"

# PyTorch wheel index per backend. The cuda backend image ships CUDA 12.8, the
# cuda13 backend ships CUDA 13.3; torch wheels bundle their own CUDA runtime,
# so these only need to be driver-compatible with the host.
TORCH_INDEX_cuda="https://download.pytorch.org/whl/cu128"
TORCH_INDEX_cuda13="https://download.pytorch.org/whl/cu130"
